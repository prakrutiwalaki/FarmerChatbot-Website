<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Farmer Chatbot</title>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<style>
body { font-family: Arial; margin: 20px; background: #f5f5f5; }
#chat { border: 1px solid #ccc; padding: 10px; height: 400px; overflow-y: scroll; background: #fff; }
.user { color: blue; }
.bot { color: green; }
button { margin-top: 10px; padding: 10px; }
</style>
</head>
<body>

<h2>🌾 Multilingual Farmer Chatbot</h2>
<div id="chat"></div>

<input type="text" id="question" placeholder="Ask your question..." style="width: 60%;">
<button onclick="sendQuestion()">Send</button>
<button onclick="startVoice()">🎤 Voice Input</button>
<br><br>
<input type="text" id="city" placeholder="Enter city for weather">
<button onclick="getWeather()">🌦 Get Weather</button>

<script>
function appendMessage(sender, msg) {
    $("#chat").append(`<p class="${sender}"><b>${sender}:</b> ${msg}</p>`);
    $("#chat").scrollTop($("#chat")[0].scrollHeight);
}

// Send question to backend
function sendQuestion() {
    let question = $("#question").val();
    if(!question) return;
    appendMessage("user", question);
    $("#question").val("");

    $.ajax({
        url: "/ask",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({question: question}),
        success: function(res) {
            appendMessage("bot", res.answer);
            speak(res.answer);
        },
        error: function(xhr, status, error) {
            appendMessage("bot", "Error: Could not get answer. Check console.");
            console.error(error);
        }
    });
}

// Get weather info
function getWeather() {
    let city = $("#city").val();
    if(!city) return;

    $.ajax({
        url: "/weather",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({city: city}),
        success: function(res) {
            appendMessage("bot", res.weather);
            speak(res.weather);
        },
        error: function() {
            appendMessage("bot", "Error fetching weather.");
        }
    });
}

// Text-to-Speech
function speak(text) {
    let utter = new SpeechSynthesisUtterance(text);
    speechSynthesis.speak(utter);
}

// Voice Input
function startVoice() {
    const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
    recognition.lang = 'en-IN';
    recognition.start();

    recognition.onresult = function(event) {
        const speech = event.results[0][0].transcript;
        $("#question").val(speech);
        sendQuestion();
    };
}
</script>

</body>
</html>